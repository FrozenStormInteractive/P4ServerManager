#!/bin/sh
# After the files of the package are removed, on an uninstallation and an upgrade.

. "$(dirname "$0")/common"

# Only on an uninstallation, when the wizard asked for it. The shared folder itself is kept, as are the roots
# chosen outside of it.
delete_data() {
    data_dir=$(saved_data_dir)
    if [ -z "$data_dir" ] || [ "$data_dir" = "/" ] || [ ! -d "$data_dir" ]; then
        report "The data of P4 Server Manager was not found. Nothing was deleted."
        return 0
    fi
    if [ -n "$(running_p4d_pids)" ]; then
        report "P4 servers still run from $data_dir. Nothing was deleted."
        return 0
    fi

    rm -rf "$data_dir/builds" "$data_dir/archive" "$data_dir/instances" "$data_dir/import"
    rm -f "$data_dir"/p4servermanager.db "$data_dir"/p4servermanager.db-*
    rm -f "$DATA_DIR_FILE"
}

if [ "$SYNOPKG_PKG_STATUS" = "UNINSTALL" ] && [ "$wizard_delete_data" = "true" ]; then
    delete_data
fi

exit 0
