#!/bin/sh
# After the files of the package are removed, on an uninstallation and an upgrade.

. "$(dirname "$0")/common"

# Only on an uninstallation, when the wizard asked for it. DSM keeps the var folder, so its content is deleted here. The
# shared folder is not touched: the servers it holds are kept.
delete_data() {
    if [ -n "$(running_p4d_pids)" ]; then
        report "P4 servers still run. Nothing was deleted."
        return 0
    fi

    rm -rf "$VAR_DIR/builds" "$VAR_DIR/archive" "$VAR_DIR/instances" "$VAR_DIR/import" "$VAR_DIR/keys" "$VAR_DIR/tmp"
    rm -f "$VAR_DIR"/p4servermanager.db "$VAR_DIR"/p4servermanager.db-* \
        "$INITIAL_USER_FILE" "$DAEMON_LOG_FILE" "$DAEMON_LOG_FILE.1"
}

if [ "$SYNOPKG_PKG_STATUS" = "UNINSTALL" ] && [ "$wizard_delete_data" = "true" ]; then
    delete_data
fi

exit 0
