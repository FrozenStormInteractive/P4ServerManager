{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "daemon",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/P4ServerManager.Daemon",
        "--no-launch-profile",
        "--",
        "--environment",
        "Development",
        "--urls",
        "https://localhost:7278;http://localhost:5247"
      ],
      "port": 5247
    },
    {
      "name": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/P4ServerManager.Daemon.UI", "run", "dev"],
      "port": 50084
    }
  ]
}
